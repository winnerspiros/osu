{
  "include_globs": [
    "Textures/**/*.png",
    "Textures/**/*.jpg",
    "Textures/**/*.jpeg",
    "Samples/**/*.wav",
    "Samples/**/*.mp3",
    "Videos/**/*.mp4"
  ],
  "exclude_globs": [],
  "enable_video_conversion": true,
  "keep_original_files": true,
  "jpeg_webp_quality": 85,
  "audio_ogg_quality": 4,
  "video_webm_crf": 36,
  "video_webm_audio_bitrate": "96k"
}
